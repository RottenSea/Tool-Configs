{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/2.66.0/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": {
      "1": "#cba6f7",
      "2": "#94e2d5"
    }
  },
  "display": {
    "separator": "",
    "color": {
      "keys": "#cba6f7",
      "title": "#fab387",
      "percent": {
        "color": {
          "green": "#94e2d5",
          "yellow": "#bb8af4",
          "red": "#f38ba8"
        }
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "key": " "
    },
    {
      "type": "datetime",
      "key": "󰅐 ",
      "format": "{year-short}/{month-pretty}/{day-pretty} {weekday-short} {hour-pretty}:{minute-pretty}:{second-pretty} {timezone-name}"
    },
    "break",
    {
      "type": "board",
      "key": "󰌢  ",
      "format": "{name}"
    },
    {
      "type": "cpu",
      "key": "├─ CPU ",
      "format": "{name} @ {freq-max}"
    },
    {
      "type": "gpu",
      "key": "├─󰢮 GPU ",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "├─ MEM ",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "swap",
      "key": "├─󰓡 SWP "
    },
    {
      "type": "monitor",
      "key": "├─󱄄 MON ",
      "format": "{name} {width}x{height} @ {refresh-rate} Hz"
    },
    {
      "type": "disk",
      "key": "╰─ DIS "
    },
    "break",
    {
      "type": "kernel",
      "key": "  "
    },
    {
      "type": "os",
      "key": "├─ OS  "
    },
    {
      "type": "packages",
      "key": "╰─ PKG ",
      "format": "{pacman}"
    },
    "break",
    {
      "type": "wm",
      "key": "  "
    },
    {
      "type": "shell",
      "key": "├─ SHE "
    },
    {
      "type": "terminal",
      "key": "├─ TER "
    },
    {
      "type": "terminalfont",
      "key": "╰─ TFO ",
      "format": "{name}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
