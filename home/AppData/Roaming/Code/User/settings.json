{
  // ================ Editor ================
  "diffEditor.codeLens": true,
  "editor.acceptSuggestionOnEnter": "off",
  "editor.cursorBlinking": "solid",
  "editor.cursorSurroundingLines": 20,
  "editor.folding": false,
  "editor.fontFamily": "Maple Mono NL NF CN",
  "editor.fontWeight": "500",
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnType": true,
  "editor.guides.bracketPairs": true,
  "editor.lightbulb.enabled": "off",
  "editor.occurrencesHighlight": "multiFile",
  "editor.selectionClipboard": false,
  "editor.suggestSelection": "recentlyUsed",
  "editor.wordWrap": "bounded",
  "editor.wordWrapColumn": 70,
  "settingsSync.ignoredSettings": [
    "-python.useEnvironmentsExtension",
    "-python-envs.terminal.showActivateButton"
  ],

  // ================ Workbench / UI ================
  "debug.showBreakpointsInOverviewRuler": true,
  "window.newWindowDimensions": "maximized",
  "window.newWindowProfile": "Default",
  "workbench.activityBar.location": "bottom",
  "workbench.browser.openLocalhostLinks": false,
  "workbench.colorCustomizations": {
    "editor.selectionBackground": "#ffffff80",
    "editor.wordHighlightBackground": "#ffff0020",
    "editor.findMatchHighlightBackground": "#ff69B480"
  },
  "workbench.colorTheme": "Dracula Theme Soft",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.useModal": "off",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.secondarySideBar.showLabels": false,
  "workbench.tree.indent": 16,

  // ================ Explorer / Files ================
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,
  "files.associations": {
    "*.jsonc": "json",
    "*.wxss": "css",
    "*.wxs": "javascript"
  },
  "files.autoGuessEncoding": true,

  // ================ Terminal ================
  "terminal.external.linuxExec": "kitty",
  "terminal.integrated.initialHint": false,
  "terminal.integrated.accessibleViewPreserveCursorPosition": true,
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.fontFamily": "Maple Mono NL NF CN",
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "/usr/bin/bash"
    },
    "zsh": {
      "path": "zsh"
    },
    "fish": {
      "path": "fish"
    }
  },

  // ================ Security ================
  "http.systemCertificatesNode": true,
  "security.workspace.trust.enabled": false,

  // ================ Git ================
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,

  // ================ Language-specific Formatters ================
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 70
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[cmake]": {
    "editor.defaultFormatter": "wysaid.clion-cmake-format"
  },
  "[glsl]": {
    "editor.defaultFormatter": "nolanderc.glsl-analyzer"
  },
  // "[wxml]": {
  //   "editor.defaultFormatter": "qiu8310.minapp-vscode"
  // },
  // "[wxss]": {
  //   "editor.defaultFormatter": "qiu8310.minapp-vscode"
  // },
  // "[wxs]": {
  //   "editor.defaultFormatter": "qiu8310.minapp-vscode"
  // },
  // "emmet.includeLanguages": {
  //   "wxml": "html"
  // },

  // ================ Python ================
  "python.terminal.useEnvFile": true,
  "python.useEnvironmentsExtension": true,
  "python-envs.terminal.showActivateButton": true,

  // ================ Prettier ================
  "prettier.singleAttributePerLine": true,
  "prettier.trailingComma": "none",

  // ================ .NET / C# ================
  "csharp.inlayHints.enableInlayHintsForImplicitObjectCreation": true,
  "csharp.inlayHints.enableInlayHintsForImplicitVariableTypes": true,
  "csharp.inlayHints.enableInlayHintsForLambdaParameterTypes": true,
  "csharp.inlayHints.enableInlayHintsForTypes": true,
  "dotnet.codeLens.enableReferencesCodeLens": false,
  "dotnet.formatting.organizeImportsOnFormat": true,
  "dotnet.inlayHints.enableInlayHintsForIndexerParameters": true,
  "dotnet.inlayHints.enableInlayHintsForLiteralParameters": true,
  "dotnet.inlayHints.enableInlayHintsForObjectCreationParameters": true,
  "dotnet.inlayHints.enableInlayHintsForOtherParameters": true,
  "dotnet.inlayHints.enableInlayHintsForParameters": true,
  "dotnet.inlayHints.suppressInlayHintsForParametersThatDifferOnlyBySuffix": true,
  "dotnet.inlayHints.suppressInlayHintsForParametersThatMatchArgumentName": true,
  "dotnet.inlayHints.suppressInlayHintsForParametersThatMatchMethodIntent": true,

  // ================ AI Extensions — Claude Code ================
  "claudeCode.allowDangerouslySkipPermissions": true,
  "claudeCode.environmentVariables": [
    {
      "name": "ANTHROPIC_BASE_URL",
      "value": "https://xxxx"
    },
    {
      "name": "ANTHROPIC_AUTH_TOKEN",
      "value": "xxxx"
    }
  ],
  "claudeCode.initialPermissionMode": "bypassPermissions",
  "claudeCode.useTerminal": true,

  // ================ AI Extensions — Gemini Code Assist ================
  "geminicodeassist.contextExclusionGitignore": false,
  "geminicodeassist.displayInlineContextHint": false,
  "geminicodeassist.inlineSuggestions.enableAuto": false,

  // ================ AI Extensions — Fitten Code ================
  "fittencode.action.documentCode.showInEditorContextMenu": false,
  "fittencode.action.explainCode.showInEditorContextMenu": false,
  "fittencode.action.findBugs.showInEditorContextMenu": false,
  "fittencode.action.generateUnitTest.showInEditorContextMenu": false,
  "fittencode.action.optimizeCode.showInEditorContextMenu": false,
  "fittencode.inlineCompletion.enable": false,
  "fittencode.languagePreference.commentPreference": "en",
  "fittencode.languagePreference.displayPreference": "en",
  "fittencode.selection.showCodeLens": false,
  "fittencode.cloudStorage.enabled": false,

  // ================ AI Extensions — VSCode Copilot ================
  "chat.disableAIFeatures": true,

  // ================ Other Extensions ================
  "codesnap.containerPadding": "0em",
  "codesnap.roundedCorners": false,
  "color-highlight.markRuler": false,
  "color-highlight.markerType": "dot-before",
  "errorLens.codeLensOnClick": "none",
  "makefile.configureOnOpen": true,
  "minapp-vscode.disableAutoConfig": true,
  "minapp-vscode.wxmlFormatter": "jsBeautifyHtml",
  "QoderCN.aI Chat.memories": false,
  "vscode_custom_css.imports": [],
  "update.mode": "manual"
}
