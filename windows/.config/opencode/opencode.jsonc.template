{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "plan",
  "snapshot": true,
  "autoupdate": false,

  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    }
  },

  "plugin": ["opencode-pty"],
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true,
      "headers": {
        "x-api-key": "YOUR_EXA_API_KEY"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer YOUR_TOKEN"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer YOUR_TOKEN"
      }
    }
  }
}
