// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)

{
  "cli_default_open_behavior": "existing_window",
  "agent_servers": {},
  "edit_predictions": {
    "provider": "zed"
  },
  "ui_font_family": "Maple Mono NL NF CN",
  "outline_panel": {
    "auto_fold_dirs": false
  },
  "context_servers": {
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "YOUR_EXA_API_KEY"
      }
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_TOKEN"
      }
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_TOKEN"
      }
    }
  },
  "context_server_timeout": 30,
  "proxy": "",
  "title_bar": {
    "show_branch_status_icon": true
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "inlay_hints": {
    "enabled": true
  },
  "inline_code_actions": true,
  "gutter": {
    "git_gutter_width": {
      "custom": 2.0
    }
  },
  "format_on_save": "on",
  "indent_guides": {
    "line_width": 2,
    "active_line_width": 2,
    "enabled": true
  },
  "soft_wrap": "editor_width",
  "toolbar": {
    "code_actions": false
  },
  "minimap": {
    "max_width_columns": 50,
    "show": "always"
  },
  "scrollbar": {
    "axes": {
      "horizontal": false
    },
    "show": "always"
  },
  "auto_update": false,
  "git_panel": {
    "tree_view": false
  },
  "terminal": {
    "button": false,
    "dock": "bottom"
  },
  "debugger": {
    "button": false,
    "dock": "bottom"
  },
  "when_closing_with_no_tabs": "keep_window_open",
  "current_line_highlight": "all",
  "cursor_blink": false,
  "cursor_shape": "block",
  "agent_buffer_font_size": 14.0,
  "agent_ui_font_size": 16.0,
  "agent_ui_font_family": "Maple Mono NL NF CN",
  "ui_font_weight": 400.0,
  "buffer_font_weight": 500.0,
  "buffer_font_family": "Maple Mono NL NF CN",
  "language_models": {
    "openai_compatible": {}
  },
  "agent": {
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "tool_permissions": {
      "tools": {
        "mcp:exa:web_search_exa": {
          "default": "allow"
        },
        "mcp:exa:web_fetch_exa": {
          "default": "allow"
        },
        "mcp:context7:resolve-library-id": {
          "default": "allow"
        },
        "mcp:context7:query-docs": {
          "default": "allow"
        },
        "terminal": {
          "always_allow": [
            {
              "pattern": "^git\\b"
            }
          ]
        }
      }
    },
    "enable_feedback": false,
    "sidebar_side": "right",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "project_panel": {
    "auto_fold_dirs": false,
    "dock": "left"
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": true,
    "anthropic_retention": false
  },
  "ui_font_size": 16.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte - No Italics",
    "dark": "Catppuccin Mocha - No Italics"
  }
}
